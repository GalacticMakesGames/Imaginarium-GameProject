MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1558459919}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9f38a12282883754fa1bb076a8c463bc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueLines:
    - character:
        name: Allara
      line: Woah what happened? Where am I?
    - character:
        name: Allara
      line: I don't recognize this part of the forest...
    - character:
        name: Allara
      line: Everything looks so... blocky? Three dimensional? And what happened to
        the sky?
    - character:
        name: Allara
      line: I wonder if this look has something to do with that sudden strange storm?
        Or was I tossed so far away from the village that I entered a completely
        different dimension? Hard to say to be honest.
    - character:
        name: Allara
      line: Maybe I can try asking around or get a better look of my surroundings
        from that tower up ahead? All I need is to just cast a...
    - character:
        name: Allara
      line: Wait... where's my sketchbook???
    - character:
        name: Allara
      line: Is that it up there?
